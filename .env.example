DATABASE_URL=postgres://user:pass@localhost:5432/receipts_dev
PORT=3000
NODE_ENV=development

# Admin login — bcrypt hash of the admin password, produced by `npm run hash-password`.
# Never put the plain password here.
ADMIN_PASSWORD_HASH=
# How long a login session lasts (hours). Default 12 if unset.
SESSION_TTL_HOURS=12

# Gmail sending — the Gmail address receipts are sent from, and a Gmail App
# Password (NOT the normal account password; requires 2-Step Verification).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# Branding shown on invoice and receipt PDFs. All optional — the defaults are
# the real Mathemajics values, set in branding.js.
BRAND_WEBSITE=www.mathemajics.com
BRAND_EMAIL=mathemajics@gmail.com
# Where the logo lives. Defaults to assets/logo.png inside the repo. If the file
# is missing or unreadable the PDFs still generate, with a text wordmark.
BRAND_LOGO_PATH=
