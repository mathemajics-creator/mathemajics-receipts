# Every environment variable this app reads. Copy to .env for local
# development; .env is gitignored and must never be committed.
#
# IN PRODUCTION THESE ARE NOT A FILE. They are set in the Railway dashboard
# (service -> Variables). No secret value belongs in this repo, in a chat, or
# in a commit — ever.
#
# Legend:  [required]  the app cannot do its job without it
#          [optional]  has a sensible default

# ── Database ────────────────────────────────────────────────────────────────
# [required] Railway PROVIDES this automatically once a Postgres database is
# added to the project — do not set it by hand there. Migrations run at boot and
# the server refuses to start if they fail.
DATABASE_URL=postgres://user:pass@localhost:5432/receipts_dev

# ── Runtime ─────────────────────────────────────────────────────────────────
# [required in production] Set NODE_ENV=production in Railway. It turns on the
# database's TLS settings and the boot-time configuration warnings.
NODE_ENV=development

# [required] Railway PROVIDES this automatically — do not set it by hand there.
# The server listens on it, on 0.0.0.0. Defaults to 3000 locally.
PORT=3000

# ── Admin login ─────────────────────────────────────────────────────────────
# [required] A bcrypt hash of your admin password, produced by
# `npm run hash-password`. The password itself is never stored anywhere.
# If this is unset the app still boots and serves, but every login is rejected
# and a warning is written to the log at startup.
ADMIN_PASSWORD_HASH=

# [optional] How long a login session lasts, in hours. Default 12.
SESSION_TTL_HOURS=12

# ── Email ───────────────────────────────────────────────────────────────────
# [required for email] The Gmail address invoices and receipts are sent from,
# and a Gmail App Password — NOT the normal account password. App passwords
# require 2-Step Verification to be switched on first.
#
# Without these the tool still records every document correctly; the email fails
# and the row shows "Email failed" with a Retry button.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# ── Branding on the PDFs ────────────────────────────────────────────────────
# [optional] All three have defaults in branding.js — the real Mathemajics
# values. Set them only to override per deployment.
BRAND_WEBSITE=www.mathemajics.com
BRAND_EMAIL=mathemajics@gmail.com
# Where the logo lives. Defaults to assets/logo.png inside the repo (which is
# committed). If the file is missing or unreadable the PDFs still generate, with
# a text wordmark instead of the image.
BRAND_LOGO_PATH=
